# InfraSketch Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: Anthropic API Key
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ============================================
# OPTIONAL: LangSmith Tracing
# ============================================
# Enable for debugging and tracing LLM calls
LANGSMITH_TRACING=False
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-key-here"
LANGSMITH_PROJECT="InfraSketch"

# ============================================
# REQUIRED: Clerk Authentication (Backend)
# ============================================
# Get your secret key from: https://dashboard.clerk.com/
# IMPORTANT: Keep this secret! Never expose in frontend code
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here

# ============================================
# RECOMMENDED: GitHub Token (repo analysis)
# ============================================
# Used by /api/analyze-repo. Without it, GitHub allows only 60 requests/hour per
# IP and a single repo analysis makes dozens, so one user can exhaust the quota
# for everyone. With a token: 5,000 requests/hour, plus access to private repos
# the token can read.
# Create a fine-grained token with "Public repositories (read-only)" access at:
# https://github.com/settings/personal-access-tokens
# In production this is read from the AWS Secrets Manager secret
# "infrasketch/github-token" first, then this env var.
GITHUB_TOKEN=

# ============================================
# OPTIONAL: Diagram <-> Design Doc Auto-Sync
# ============================================
# When true, a structural diagram change schedules a debounced LLM pass that
# rewrites the affected design-doc sections. Paid plans only, and each sync that
# actually changes something costs 2 credits.
# Defaults to false, so auto-sync is OFF locally unless you set this. It is
# already enabled on the production Lambda.
# To see why a sync did not fire, grep the logs for "sync: not scheduled".
ENABLE_AUTO_SYNC=false

# ============================================
# OPTIONAL: Rate Limiting Configuration
# ============================================
# Requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60
# Maximum burst size (number of requests that can be made instantly)
RATE_LIMIT_BURST=10

# ============================================
# OPTIONAL: API Key Authentication
# ============================================
# Set to 'true' to require API key authentication
REQUIRE_API_KEY=false
# Comma-separated list of valid API keys
# Generate secure keys with: openssl rand -hex 32
VALID_API_KEYS=""

# ============================================
# OPTIONAL: Additional CORS Origins
# ============================================
# Comma-separated list of additional allowed origins
# The following are always allowed:
#   - https://infrasketch.net (production)
#   - https://www.infrasketch.net (production www)
#   - http://localhost:5173 (local dev)
EXTRA_ALLOWED_ORIGINS=""

# ============================================
# AWS Configuration (if using AWS Secrets Manager)
# ============================================
AWS_REGION=us-east-1
